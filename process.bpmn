<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Teacher" name="Викладач" processRef="Process_Teacher" />
    <bpmn:participant id="Participant_System" name="Електронний журнал" processRef="Process_System" />
    <bpmn:messageFlow id="MF_Submit" sourceRef="T_Send" targetRef="S_Start" />
    <bpmn:messageFlow id="MF_Denied" sourceRef="S_EndDenied" targetRef="T_CatchDenied" />
    <bpmn:messageFlow id="MF_Invalid" sourceRef="S_EndInvalid" targetRef="T_CatchInvalid" />
    <bpmn:messageFlow id="MF_Updated" sourceRef="S_EndUpdated" targetRef="T_CatchUpdated" />
    <bpmn:messageFlow id="MF_Saved" sourceRef="S_EndSaved" targetRef="T_CatchSaved" />
  </bpmn:collaboration>
  <bpmn:message id="Message_submitGrade" name="submitGrade" />
  <bpmn:message id="Message_GradeSaved" name="GradeSaved" />
  <bpmn:message id="Message_GradeUpdated" name="GradeUpdated" />
  <bpmn:message id="Message_ValidationError" name="ValidationError" />
  <bpmn:message id="Message_AccessDenied" name="AccessDenied" />
  <bpmn:process id="Process_Teacher" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Teacher">
      <bpmn:lane id="Lane_Teacher" name="Викладач">
        <bpmn:flowNodeRef>T_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_GwComment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Comment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CatchDenied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EndDenied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CatchInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CatchUpdated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EndUpdated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CatchSaved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EndSaved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EndNoReply</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="T_Start" name="Викладач хоче виставити оцінку">
      <bpmn:outgoing>F_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Select" name="Обрати своє заняття та студента групи">
      <bpmn:documentation>seq: getMyLessons, getGroupRoster; uc: Переглянути свої заняття та склад групи (include)</bpmn:documentation>
      <bpmn:incoming>F_T1</bpmn:incoming>
      <bpmn:outgoing>F_T2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="T_Merge1">
      <bpmn:documentation>Злиття початку й повернення на виправлення балу</bpmn:documentation>
      <bpmn:incoming>F_T2</bpmn:incoming>
      <bpmn:incoming>F_T16</bpmn:incoming>
      <bpmn:outgoing>F_T3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Score" name="Ввести бал">
      <bpmn:documentation>req: REQ-1</bpmn:documentation>
      <bpmn:incoming>F_T3</bpmn:incoming>
      <bpmn:outgoing>F_T4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="T_GwComment" name="Додати коментар?" default="F_T6">
      <bpmn:documentation>extend UC: Додати коментар до оцінки</bpmn:documentation>
      <bpmn:incoming>F_T4</bpmn:incoming>
      <bpmn:outgoing>F_T5</bpmn:outgoing>
      <bpmn:outgoing>F_T6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Comment" name="Ввести коментар">
      <bpmn:documentation>req: REQ-6</bpmn:documentation>
      <bpmn:incoming>F_T5</bpmn:incoming>
      <bpmn:outgoing>F_T7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="T_Merge2">
      <bpmn:incoming>F_T6</bpmn:incoming>
      <bpmn:incoming>F_T7</bpmn:incoming>
      <bpmn:outgoing>F_T8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_Send" name="Надіслати оцінку" messageRef="Message_submitGrade">
      <bpmn:documentation>seq: submitGrade</bpmn:documentation>
      <bpmn:incoming>F_T8</bpmn:incoming>
      <bpmn:outgoing>F_T9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="T_Wait" name="Очікування відповіді" instantiate="false" eventGatewayType="Exclusive">
      <bpmn:documentation>Викладач чекає одне з відповідних повідомлень або таймер</bpmn:documentation>
      <bpmn:incoming>F_T9</bpmn:incoming>
      <bpmn:outgoing>F_T10</bpmn:outgoing>
      <bpmn:outgoing>F_T11</bpmn:outgoing>
      <bpmn:outgoing>F_T12</bpmn:outgoing>
      <bpmn:outgoing>F_T13</bpmn:outgoing>
      <bpmn:outgoing>F_T14</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="T_CatchDenied" name="AccessDenied">
      <bpmn:incoming>F_T10</bpmn:incoming>
      <bpmn:outgoing>F_T15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="T_CatchDenied_def" messageRef="Message_AccessDenied" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="T_EndDenied" name="Відмовлено в доступі">
      <bpmn:documentation>Gherkin S4</bpmn:documentation>
      <bpmn:incoming>F_T15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="T_CatchInvalid" name="ValidationError">
      <bpmn:incoming>F_T11</bpmn:incoming>
      <bpmn:outgoing>F_T16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="T_CatchInvalid_def" messageRef="Message_ValidationError" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="T_CatchUpdated" name="GradeUpdated">
      <bpmn:incoming>F_T12</bpmn:incoming>
      <bpmn:outgoing>F_T17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="T_CatchUpdated_def" messageRef="Message_GradeUpdated" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="T_EndUpdated" name="Оцінку змінено">
      <bpmn:documentation>Gherkin S3</bpmn:documentation>
      <bpmn:incoming>F_T17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="T_CatchSaved" name="GradeSaved">
      <bpmn:incoming>F_T13</bpmn:incoming>
      <bpmn:outgoing>F_T18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="T_CatchSaved_def" messageRef="Message_GradeSaved" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="T_EndSaved" name="Оцінку збережено">
      <bpmn:documentation>Gherkin S1, S5</bpmn:documentation>
      <bpmn:incoming>F_T18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="T_Timer" name="Відповіді немає 10 с">
      <bpmn:incoming>F_T14</bpmn:incoming>
      <bpmn:outgoing>F_T19</bpmn:outgoing>
      <bpmn:timerEventDefinition id="T_Timer_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="T_Manual" name="Перевірити журнал пізніше">
      <bpmn:incoming>F_T19</bpmn:incoming>
      <bpmn:outgoing>F_T20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="T_EndNoReply" name="Збереження не підтверджено">
      <bpmn:incoming>F_T20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_T1" sourceRef="T_Start" targetRef="T_Select" />
    <bpmn:sequenceFlow id="F_T2" sourceRef="T_Select" targetRef="T_Merge1" />
    <bpmn:sequenceFlow id="F_T3" sourceRef="T_Merge1" targetRef="T_Score" />
    <bpmn:sequenceFlow id="F_T4" sourceRef="T_Score" targetRef="T_GwComment" />
    <bpmn:sequenceFlow id="F_T5" sourceRef="T_GwComment" targetRef="T_Comment" name="так">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wantsComment == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_T6" sourceRef="T_GwComment" targetRef="T_Merge2" name="ні" />
    <bpmn:sequenceFlow id="F_T7" sourceRef="T_Comment" targetRef="T_Merge2" />
    <bpmn:sequenceFlow id="F_T8" sourceRef="T_Merge2" targetRef="T_Send" />
    <bpmn:sequenceFlow id="F_T9" sourceRef="T_Send" targetRef="T_Wait" />
    <bpmn:sequenceFlow id="F_T10" sourceRef="T_Wait" targetRef="T_CatchDenied" />
    <bpmn:sequenceFlow id="F_T11" sourceRef="T_Wait" targetRef="T_CatchInvalid" />
    <bpmn:sequenceFlow id="F_T12" sourceRef="T_Wait" targetRef="T_CatchUpdated" />
    <bpmn:sequenceFlow id="F_T13" sourceRef="T_Wait" targetRef="T_CatchSaved" />
    <bpmn:sequenceFlow id="F_T14" sourceRef="T_Wait" targetRef="T_Timer" />
    <bpmn:sequenceFlow id="F_T15" sourceRef="T_CatchDenied" targetRef="T_EndDenied" />
    <bpmn:sequenceFlow id="F_T16" sourceRef="T_CatchInvalid" targetRef="T_Merge1" name="виправити бал" />
    <bpmn:sequenceFlow id="F_T17" sourceRef="T_CatchUpdated" targetRef="T_EndUpdated" />
    <bpmn:sequenceFlow id="F_T18" sourceRef="T_CatchSaved" targetRef="T_EndSaved" />
    <bpmn:sequenceFlow id="F_T19" sourceRef="T_Timer" targetRef="T_Manual" />
    <bpmn:sequenceFlow id="F_T20" sourceRef="T_Manual" targetRef="T_EndNoReply" />
  </bpmn:process>
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_System">
      <bpmn:lane id="Lane_UI" name="GradebookUI">
        <bpmn:flowNodeRef>S_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EndDenied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EndInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EndUpdated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EndSaved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GS" name="GradeService">
        <bpmn:flowNodeRef>S_ParSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Lesson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_ParJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwScore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Create</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Start" name="submitGrade">
      <bpmn:outgoing>F_S1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="S_Start_def" messageRef="Message_submitGrade" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="S_Forward" name="Передати запит сервісу оцінок">
      <bpmn:documentation>seq: saveGrade</bpmn:documentation>
      <bpmn:incoming>F_S1</bpmn:incoming>
      <bpmn:outgoing>F_S2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="S_EndDenied" name="AccessDenied">
      <bpmn:incoming>F_S9</bpmn:incoming>
      <bpmn:messageEventDefinition id="S_EndDenied_def" messageRef="Message_AccessDenied" />
    </bpmn:endEvent>
    <bpmn:endEvent id="S_EndInvalid" name="ValidationError">
      <bpmn:incoming>F_S12</bpmn:incoming>
      <bpmn:messageEventDefinition id="S_EndInvalid_def" messageRef="Message_ValidationError" />
    </bpmn:endEvent>
    <bpmn:endEvent id="S_EndUpdated" name="GradeUpdated">
      <bpmn:incoming>F_S16</bpmn:incoming>
      <bpmn:messageEventDefinition id="S_EndUpdated_def" messageRef="Message_GradeUpdated" />
    </bpmn:endEvent>
    <bpmn:endEvent id="S_EndSaved" name="GradeSaved">
      <bpmn:incoming>F_S17</bpmn:incoming>
      <bpmn:messageEventDefinition id="S_EndSaved_def" messageRef="Message_GradeSaved" />
    </bpmn:endEvent>
    <bpmn:parallelGateway id="S_ParSplit">
      <bpmn:documentation>seq: par (завантаження заняття й студента паралельно)</bpmn:documentation>
      <bpmn:incoming>F_S2</bpmn:incoming>
      <bpmn:outgoing>F_S3</bpmn:outgoing>
      <bpmn:outgoing>F_S4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="S_Lesson" name="Завантажити заняття">
      <bpmn:documentation>seq: findById; entity: LESSON</bpmn:documentation>
      <bpmn:incoming>F_S3</bpmn:incoming>
      <bpmn:outgoing>F_S5</bpmn:outgoing>
      <bpmn:dataInputAssociation id="A_Lesson">
        <bpmn:sourceRef>D_Lesson</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S_Student" name="Завантажити студента">
      <bpmn:documentation>seq: findById; entity: STUDENT</bpmn:documentation>
      <bpmn:incoming>F_S4</bpmn:incoming>
      <bpmn:outgoing>F_S6</bpmn:outgoing>
      <bpmn:dataInputAssociation id="A_Student">
        <bpmn:sourceRef>D_Student</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="S_ParJoin">
      <bpmn:incoming>F_S5</bpmn:incoming>
      <bpmn:incoming>F_S6</bpmn:incoming>
      <bpmn:outgoing>F_S7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="S_GwAccess" name="Доступ підтверджено?" default="F_S9">
      <bpmn:documentation>req: REQ-5</bpmn:documentation>
      <bpmn:incoming>F_S7</bpmn:incoming>
      <bpmn:outgoing>F_S8</bpmn:outgoing>
      <bpmn:outgoing>F_S9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="S_Validate" name="Перевірити бал">
      <bpmn:documentation>seq: validateScore; req: REQ-1</bpmn:documentation>
      <bpmn:incoming>F_S8</bpmn:incoming>
      <bpmn:outgoing>F_S10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="S_GwScore" name="Бал допустимий?" default="F_S12">
      <bpmn:documentation>req: REQ-1, REQ-3</bpmn:documentation>
      <bpmn:incoming>F_S10</bpmn:incoming>
      <bpmn:outgoing>F_S11</bpmn:outgoing>
      <bpmn:outgoing>F_S12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_Find" name="Знайти оцінку студента за заняття">
      <bpmn:documentation>seq: findByStudentAndLesson; entity: GRADE</bpmn:documentation>
      <bpmn:incoming>F_S11</bpmn:incoming>
      <bpmn:outgoing>F_S13</bpmn:outgoing>
      <bpmn:dataInputAssociation id="A_Find">
        <bpmn:sourceRef>D_GradeFind</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="S_GwExists" name="Оцінка вже існує?" default="F_S15">
      <bpmn:documentation>req: REQ-2, REQ-4</bpmn:documentation>
      <bpmn:incoming>F_S13</bpmn:incoming>
      <bpmn:outgoing>F_S14</bpmn:outgoing>
      <bpmn:outgoing>F_S15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_Update" name="Замінити бал в оцінці">
      <bpmn:documentation>seq: updateGrade; entity: GRADE; req: REQ-4</bpmn:documentation>
      <bpmn:incoming>F_S14</bpmn:incoming>
      <bpmn:outgoing>F_S16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="A_Upd">
        <bpmn:targetRef>D_GradeUpd</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S_Create" name="Створити оцінку">
      <bpmn:documentation>seq: create; entity: GRADE; req: REQ-2, REQ-6</bpmn:documentation>
      <bpmn:incoming>F_S15</bpmn:incoming>
      <bpmn:outgoing>F_S17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="A_New">
        <bpmn:targetRef>D_GradeNew</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObjectReference id="D_Lesson" name="LESSON" dataObjectRef="DO_Lesson" />
    <bpmn:dataObjectReference id="D_Student" name="STUDENT" dataObjectRef="DO_Student" />
    <bpmn:dataObjectReference id="D_GradeFind" name="GRADE" dataObjectRef="DO_Grade" />
    <bpmn:dataObjectReference id="D_GradeUpd" name="GRADE" dataObjectRef="DO_Grade" />
    <bpmn:dataObjectReference id="D_GradeNew" name="GRADE" dataObjectRef="DO_Grade" />
    <bpmn:dataObject id="DO_Lesson" name="LESSON" />
    <bpmn:dataObject id="DO_Student" name="STUDENT" />
    <bpmn:dataObject id="DO_Grade" name="GRADE" />
    <bpmn:sequenceFlow id="F_S1" sourceRef="S_Start" targetRef="S_Forward" />
    <bpmn:sequenceFlow id="F_S2" sourceRef="S_Forward" targetRef="S_ParSplit" />
    <bpmn:sequenceFlow id="F_S3" sourceRef="S_ParSplit" targetRef="S_Lesson" />
    <bpmn:sequenceFlow id="F_S4" sourceRef="S_ParSplit" targetRef="S_Student" />
    <bpmn:sequenceFlow id="F_S5" sourceRef="S_Lesson" targetRef="S_ParJoin" />
    <bpmn:sequenceFlow id="F_S6" sourceRef="S_Student" targetRef="S_ParJoin" />
    <bpmn:sequenceFlow id="F_S7" sourceRef="S_ParJoin" targetRef="S_GwAccess" />
    <bpmn:sequenceFlow id="F_S8" sourceRef="S_GwAccess" targetRef="S_Validate" name="доступ є">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">lesson.teacher_id == teacherId and student.group_id == lesson.group_id</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_S9" sourceRef="S_GwAccess" targetRef="S_EndDenied" name="немає доступу" />
    <bpmn:sequenceFlow id="F_S10" sourceRef="S_Validate" targetRef="S_GwScore" />
    <bpmn:sequenceFlow id="F_S11" sourceRef="S_GwScore" targetRef="S_Find" name="допустимий">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">score is integer and score &gt;= 0 and score &lt;= 100</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_S12" sourceRef="S_GwScore" targetRef="S_EndInvalid" name="бал некоректний" />
    <bpmn:sequenceFlow id="F_S13" sourceRef="S_Find" targetRef="S_GwExists" />
    <bpmn:sequenceFlow id="F_S14" sourceRef="S_GwExists" targetRef="S_Update" name="існує">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">grade != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_S15" sourceRef="S_GwExists" targetRef="S_Create" name="немає" />
    <bpmn:sequenceFlow id="F_S16" sourceRef="S_Update" targetRef="S_EndUpdated" />
    <bpmn:sequenceFlow id="F_S17" sourceRef="S_Create" targetRef="S_EndSaved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Teacher_di" bpmnElement="Participant_Teacher" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="2560" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Teacher_di" bpmnElement="Lane_Teacher" isHorizontal="true">
        <dc:Bounds x="190" y="60" width="2530" height="440" />
